<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- CSV export / import: Powerbox save and open panels grant access to the chosen file. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Sparkle: the appcast fetch and the dmg download, and the installer services it talks to. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<!-- The self-signed release certificate has no Team ID, and hardened runtime library validation
	     then refuses to load Sparkle.framework ("different Team IDs"), even with the same
	     certificate. An accepted trade-off: docs/agents/release-signing.md. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
