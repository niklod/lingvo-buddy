#!/bin/bash
# Restarts LingvoBuddy after an install, so an update takes effect without a manual quit.
# The installer runs this as root; $3 is the target volume. Output goes to /var/log/install.log.
# Always exit 0: the files are already in place, and a failed relaunch must not report a failed install.

app="${3%/}/Applications/LingvoBuddy.app"
binary="$app/Contents/MacOS/LingvoBuddy"

# Match the full path: dev builds and agent instances of the same bundle id keep running.
if pkill -f "^$binary" 2>/dev/null; then
	for _ in $(seq 1 50); do
		pgrep -f "^$binary" >/dev/null || break
		sleep 0.1
	done
fi

console_user=$(stat -f %Su /dev/console)
if [ -z "$console_user" ] || [ "$console_user" = "root" ]; then
	echo "LingvoBuddy postinstall: nobody is logged in, skip the launch"
	exit 0
fi
console_uid=$(id -u "$console_user")

# Started as root, the app would run outside the user's session and sandbox container.
if ! launchctl asuser "$console_uid" sudo -u "$console_user" open "$app"; then
	echo "LingvoBuddy postinstall: could not launch $app"
fi
exit 0
