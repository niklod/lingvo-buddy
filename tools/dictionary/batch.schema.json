{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/niklod/lingvo-buddy/tools/dictionary/batch.schema.json",
  "title": "LingvoBuddy dictionary batch",
  "description": "One batch of 500 ranks: batch-NN covers ranks (NN-1)*500+1 to NN*500. Ranks up to 2000 are quiz tier, the rest lookup tier. Generated by tools/dictionary/write_schema.py; the validator checks more rules than this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch",
    "entries"
  ],
  "properties": {
    "batch": {
      "type": "string",
      "pattern": "^batch-(\\d{2})$"
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "headword",
              "tier",
              "pos",
              "translations",
              "ipa",
              "example",
              "synonym_group"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "headword": {
                "type": "string",
                "description": "Exactly the headword of this rank in data/wordlist/wordlist.tsv."
              },
              "tier": {
                "const": "quiz"
              },
              "pos": {
                "enum": [
                  "noun",
                  "verb",
                  "adjective",
                  "adverb",
                  "pronoun",
                  "preposition",
                  "conjunction",
                  "determiner",
                  "numeral",
                  "interjection",
                  "other"
                ]
              },
              "translations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[А-Яа-яЁё]+(?:[ -][А-Яа-яЁё]+)*$",
                  "maxLength": 40
                }
              },
              "ipa": {
                "type": "string",
                "pattern": "^/[aeiuæɑɒɔəɜɛɪʊʌbdfghjklmnprstvwxzŋθðʃʒɡʔːˈˌ.]+/$"
              },
              "example": {
                "type": "string",
                "minLength": 10,
                "maxLength": 140,
                "pattern": "^[A-Z0-9\\\"'][A-Za-z0-9 ,.;:!?'\\\"()\\-–—’]*[.!?]$"
              },
              "synonym_group": {
                "type": "string",
                "description": "Headword of the lowest-ranked quiz-tier word with the same main meaning; the entry's own headword if none."
              },
              "example_ru": {
                "type": "string",
                "description": "A natural Russian translation of example, in the meaning of the first translation.",
                "minLength": 1,
                "maxLength": 180,
                "pattern": "^[А-ЯЁ0-9«\\\"][А-Яа-яЁё0-9 ,.;:!?\\\"()«»\\-–—]*[.!?»\\\"]$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "headword",
              "tier",
              "pos",
              "translations",
              "ipa"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "headword": {
                "type": "string",
                "description": "Exactly the headword of this rank in data/wordlist/wordlist.tsv."
              },
              "tier": {
                "const": "lookup"
              },
              "pos": {
                "enum": [
                  "noun",
                  "verb",
                  "adjective",
                  "adverb",
                  "pronoun",
                  "preposition",
                  "conjunction",
                  "determiner",
                  "numeral",
                  "interjection",
                  "other"
                ]
              },
              "translations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[А-Яа-яЁё]+(?:[ -][А-Яа-яЁё]+)*$",
                  "maxLength": 40
                }
              },
              "ipa": {
                "type": "string",
                "pattern": "^/[aeiuæɑɒɔəɜɛɪʊʌbdfghjklmnprstvwxzŋθðʃʒɡʔːˈˌ.]+/$"
              },
              "example": {
                "type": "string",
                "minLength": 10,
                "maxLength": 140,
                "pattern": "^[A-Z0-9\\\"'][A-Za-z0-9 ,.;:!?'\\\"()\\-–—’]*[.!?]$"
              },
              "example_ru": {
                "type": "string",
                "description": "A natural Russian translation of example, in the meaning of the first translation.",
                "minLength": 1,
                "maxLength": 180,
                "pattern": "^[А-ЯЁ0-9«\\\"][А-Яа-яЁё0-9 ,.;:!?\\\"()«»\\-–—]*[.!?»\\\"]$"
              }
            }
          }
        ]
      }
    }
  }
}
